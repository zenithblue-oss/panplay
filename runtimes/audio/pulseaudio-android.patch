PulseAudio 17.0 for Android (bionic, NDK). Based on termux-packages packages/pulseaudio/meson.patch
(same licence as PulseAudio): bionic declares PTHREAD_PRIO_INHERIT but has no pthread_mutexattr_setprotocol,
has no libintl, declares backtrace() only from API 33, has a kernel <sys/capability.h> (no libcap), must not drop privileges
(app sandbox; termux no_priv_drop.patch does the same), and module-aaudio-sink (runtimes/audio/module-aaudio-sink.c,
copied into src/modules/aaudio/ by scripts/build-audio.sh) links libaaudio.

diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -172,7 +172,6 @@ cdata.set_quoted('PA_ALSA_DATA_DIR', alsadatadir)
 cdata.set_quoted('DESKTOPFILEDIR', join_paths(datadir, 'applications'))
 cdata.set_quoted('PULSE_LOCALEDIR', localedir)
 cdata.set_quoted('GETTEXT_PACKAGE', 'pulseaudio')
-cdata.set('ENABLE_NLS', 1)
 cdata.set('top_srcdir', meson.source_root())

 # Platform specifics
@@ -232,7 +231,6 @@ check_headers = [
   'arpa/inet.h',
   'byteswap.h',
   'dlfcn.h',
-  'execinfo.h',
   'grp.h',
   'langinfo.h',
   'linux/sockios.h',
@@ -249,7 +247,6 @@ check_headers = [
   'sched.h',
   'stdint.h',
   'sys/atomic.h',
-  'sys/capability.h',
   'sys/conf.h',
   'sys/dl.h',
   'sys/eventfd.h',
@@ -286,10 +283,6 @@ if host_machine.system() != 'windows'
   endif
 endif

-if cc.has_header_symbol('pthread.h', 'PTHREAD_PRIO_INHERIT')
-  cdata.set('HAVE_PTHREAD_PRIO_INHERIT', 1)
-endif
-
 # Headers which are usable

 check_usable_headers = [
@@ -381,7 +375,7 @@ if cc.has_function('dgettext')
     libintl_dep = cc.find_library('intl')
   endif
 else
-  libintl_dep = cc.find_library('intl')
+  libintl_dep = []
 endif

 # Symbols
@@ -448,6 +442,7 @@ endif
 # Core Dependencies

 libm_dep = cc.find_library('m', required : true)
+aaudio_dep = cc.find_library('aaudio', required : true)

 thread_dep = dependency('threads')
 foreach f : [
diff --git a/src/modules/meson.build b/src/modules/meson.build
--- a/src/modules/meson.build
+++ b/src/modules/meson.build
@@ -58,6 +58,7 @@ all_modules = [
   [ 'module-virtual-sink', 'module-virtual-sink.c' ],
   [ 'module-virtual-source', 'module-virtual-source.c' ],
   [ 'module-volume-restore', 'module-volume-restore.c' ],
+  [ 'module-aaudio-sink', 'aaudio/module-aaudio-sink.c', [], [], [aaudio_dep] ],
 ]

 if host_machine.system() == 'windows'
diff --git a/src/daemon/caps.c b/src/daemon/caps.c
--- a/src/daemon/caps.c
+++ b/src/daemon/caps.c
@@ -44,6 +44,9 @@ int setresuid(uid_t r, uid_t e, uid_t s);

 /* Drop root rights when called SUID root */
 void pa_drop_root(void) {
+#ifdef __ANDROID__
+    return; /* app sandbox: no SUID, and seccomp kills set*id() */
+#endif

 #ifdef HAVE_GETUID
     uid_t uid;
